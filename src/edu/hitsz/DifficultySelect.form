<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="edu.hitsz.DifficultySelect">
  <grid id="27dc6" binding="DifficultySelectPanel" layout-manager="GridLayoutManager" row-count="3" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="292"/>
    </constraints>
    <properties>
      <background color="-1033"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="24ab4" class="javax.swing.JLabel" binding="DifficultyCoefficient">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <background color="-1033"/>
          <foreground color="-15395562"/>
          <text value="Difficulty coefficient"/>
        </properties>
      </component>
      <component id="8eeb3" class="javax.swing.JTextField" binding="textField">
        <constraints>
          <grid row="0" column="1" row-span="2" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
        <properties>
          <background color="-1033"/>
        </properties>
      </component>
      <component id="e150c" class="javax.swing.JButton" binding="ConfirmButton">
        <constraints>
          <grid row="0" column="2" row-span="3" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <background color="-1033"/>
          <foreground color="-15395562"/>
          <text value="confirm"/>
        </properties>
      </component>
      <component id="1ebba" class="javax.swing.JTextField" binding="userTextField" default-binding="true">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
        <properties>
          <background color="-1033"/>
          <foreground color="-15395562"/>
          <text value="User"/>
        </properties>
      </component>
      <component id="9a425" class="javax.swing.JLabel" binding="name">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <foreground color="-15395562"/>
          <text value="Name"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
