@startuml
'https://plantuml.com/class-diagram

interface GradeDao{
+ findById(String id):List<Map<String,Object>>
+ getAllGrades():List<Map<String,Object>>
+ addGrade(String id,int grade , String time):void
+ deleteGrade(String id):void
}

class GradeDaoImpl{
- grades:List<Map<String,Object>>
+ findById(String id):List<Map<String,Object>>
+ getAllGrades():List<Map<String,Object>>
+ addGrade(String id,int grade , String time):void
+ deleteGrade(String id):void
+ loadGradeFile():void
+ writeGradeFile():void
}

GradeDao <-- GradeDaoImpl
@enduml